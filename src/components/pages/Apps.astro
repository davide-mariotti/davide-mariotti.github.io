---
import { ArrowUpRight } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';
import { localize, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = {
  en: {
    title: 'Apps',
    description: 'Apps by Davide Mariotti: Sentinel, a tiny Windows utility, and AscendKeep, an Android game in development.',
    h: ['Apps I made', 'because I needed them, or wanted to play them.'],
    lead: 'Sentinel runs on Windows and asks for nothing. AscendKeep is a game for Android, still in the oven.',
    sentinel: 'Keeps your Windows PC awake. Lunch break, battery alerts, an eye in the tray that tells you what it\'s doing.',
    discover: 'Discover',
    ascendkeep: 'A tower defense where losing is part of the plan: waves of Voidborn, 100 tiers, bosses, a skill tree.',
    dev: 'in development',
  },
  it: {
    title: 'App',
    description: 'Le app di Davide Mariotti: Sentinel, una piccola utility per Windows, e AscendKeep, un gioco Android in sviluppo.',
    h: ['App che ho fatto', 'perché mi servivano, o perché volevo giocarci.'],
    lead: 'Sentinel gira su Windows e non chiede niente. AscendKeep è un gioco per Android, ancora in forno.',
    sentinel: "Tiene sveglio il tuo PC Windows. Pausa pranzo, avvisi batteria, un occhio nella tray che ti dice cosa sta facendo.",
    discover: 'Scopri',
    ascendkeep: 'Un tower defense dove perdere fa parte del piano: ondate di Voidborn, 100 tier, boss, un albero delle skill.',
    dev: 'in sviluppo',
  },
}[lang];
---
<Layout lang={lang} title={c.title} description={c.description} path="/apps/">
  <section class="wrap pb-16 pt-40">
    <p class="kicker blur-word">{c.title}</p>
    <h1 class="h-display mt-6 !text-[clamp(2.6rem,7vw,6.5rem)]"><span class="blur-word" style="--i:1">{c.h[0]}</span><br /><span class="blur-word serif grad" style="--i:2">{c.h[1]}</span></h1>
    <p class="lead blur-word mt-8 max-w-xl" style="--i:3">{c.lead}</p>
  </section>

  <section class="wrap grid gap-4 pb-12 md:grid-cols-2">
    <a href={localize(lang, '/apps/sentinel/')} class="spot reveal group flex flex-col gap-8 p-8 sm:flex-row sm:items-center">
      <img src="/assets/icons/apps/sentinel.svg" alt="" width="112" height="112" class="size-28 shrink-0 drop-shadow-[0_20px_40px_rgb(14_116_144/0.45)] transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-105" />
      <div>
        <div class="flex flex-wrap gap-2"><span class="chip">Windows</span><span class="chip">v2.5.0</span><span class="chip">75 KB</span></div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Sentinel</h2>
        <p class="mt-2 text-muted">{c.sentinel}</p>
        <p class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent">{c.discover}<ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></p>
      </div>
    </a>
    <a href={localize(lang, '/apps/ascendkeep/')} class="spot reveal group flex flex-col gap-8 p-8 sm:flex-row sm:items-center" style="--d:90ms">
      <img src="/assets/icons/apps/ascendkeep.svg" alt="" width="112" height="112" class="size-28 shrink-0 drop-shadow-[0_20px_40px_rgb(91_33_182/0.5)] transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-105" />
      <div>
        <div class="flex flex-wrap gap-2"><span class="chip">Android</span><span class="chip">Godot</span><span class="chip">{c.dev}</span></div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">AscendKeep</h2>
        <p class="mt-2 text-muted">{c.ascendkeep}</p>
        <p class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent">{c.discover}<ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></p>
      </div>
    </a>
  </section>
</Layout>
