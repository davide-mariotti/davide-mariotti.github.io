---
import { Download, Check, X, Usb, ScanSearch, Unlink, MemoryStick, Scale, ShieldExclamationPoint, Coffee, ArrowUpRight, Film, Archive, Image, AppWindow, Music, CodeXml, FileText, Cog, File, Timer, Trash2, Package, Power, History, Bug, Bell } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';
import { SOCIAL, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const EXE = 'https://github.com/davide-mariotti/Hoard/raw/main/Hoard.exe';
const ZIP = 'https://github.com/davide-mariotti/Hoard/raw/main/Hoard-portable.zip';
const REPO = 'https://github.com/davide-mariotti/Hoard';
const img = (name: string) => `/assets/img/hoard/${name}-${lang}.webp`;

const c = {
  en: {
    description: 'Hoard shows what fills your Windows disks: a map of every folder, coloured by kind of file, the biggest files, what can go. It deletes nothing. Free, no install, no internet.',
    kicker: 'Windows app · v0.1.0',
    tagline: ['What fills your disk,', 'on a map.'],
    download: 'Download (1.1 MB)',
    portable: 'Portable (zip)',
    source: 'Source code',
    meta: 'Windows 10 and 11, 64-bit · nothing to install · free, MIT license',
    shotAlt: 'Hoard\'s window: drive C: as a map of tiles coloured by kind of file, with the breakdown by kind on the right',
    does: 'What it does', doesnt: "What it doesn't",
    doesList: [
      'Reads a whole drive: a system drive with a million files in under a minute on an NVMe, a few seconds the second time.',
      'Shows it as a map: every folder and file is a tile as big as the space it takes, coloured by what fills it.',
      'Click a folder to go in, right-click anything to see it in Explorer.',
      'Lists the 50 biggest files on the drive, and what each folder holds by kind of file.',
      'Points at what can usually go: temporary files, Downloads, Recycle Bin, Windows.old, package caches, node_modules.',
      'Watches free space from the tray and warns you once when a drive drops under your limit.',
    ],
    doesntList: [
      'Delete anything. Hoard shows, Explorer deletes, with the Recycle Bin as a safety net.',
      'Count things twice: junctions and links are skipped, OneDrive files kept online only count as zero.',
      'Keep a million files in memory: only folders, about 50 MB for a full system drive, dropped when you close the window.',
      'Connect to the internet. No telemetry, no auto-updates, no account.',
      'Ask for administrator rights. It offers them, for the folders closed to normal users.',
      'Make room by itself. Where the space went, it tells you. What to throw away is still your call.',
    ],
    mapKicker: 'The map',
    mapTitle: ['Every tile as big as', 'the space it takes.'],
    mapLead: 'A list of folders tells you numbers. A map tells you at a glance that half the disk is one game. Big folders open up to show what\'s inside them, the colour says what kind of file fills each tile, and hovering one gives you name, size and share.',
    mapAlt: 'A user folder in Hoard: videos, AppData, Downloads, pictures and projects as tiles, with the folders worth a look on the right',
    kinds: ['Video', 'Archives and disk images', 'Pictures', 'Programs and games', 'Audio', 'Code and dev', 'Documents', 'System, logs and cache', 'Everything else'],
    kindsNote: 'Eight colours from a palette checked for colour-blind readers, grey for the rest. The kind comes from the extension.',
    howKicker: 'How it works',
    howTitle: ['Fast, light,', 'and honest about what it missed.'],
    howLead: 'While it reads you see the counters and the main folders growing. A million files is a lot of folders: Hoard reads sixteen at a time.',
    scanAlt: 'Hoard reading drive C: files, folders and gigabytes found so far, and the main folders as growing bars',
    steps: [
      { t: 'One call per folder', d: 'FindFirstFileEx hands over name, size and attributes of everything in a folder in one go. No extra call per file, sixteen folders at once.' },
      { t: 'Count once', d: 'Junctions and symbolic links are skipped, so nothing is counted twice and no link sends Hoard round in circles. Online-only OneDrive files count as zero.' },
      { t: 'Keep only folders', d: 'The files of a folder are listed again when you open it: a full system drive takes about 50 MB, and what you see is up to date.' },
      { t: 'Say what\'s missing', d: 'What Hoard found against what the drive says it uses: the difference is restore points and closed folders. Restart as administrator reads most of them.' },
    ],
    lookKicker: 'Worth a look',
    lookTitle: ['The usual suspects,', 'already found.'],
    lookLead: 'Folders that fill up on their own and can usually be emptied. Each one with a line on what it is and how to clear it, a button to see it on the map and one to open it in Explorer.',
    hogs: ['Temporary files', 'Downloads', 'Recycle Bin', 'Windows.old', 'Crash dumps', 'npm, Yarn, pip, NuGet, Gradle caches', 'Every node_modules', 'Hibernation file'],
    trayTitle: 'Before the disk is full',
    trayText: 'In the tray Hoard keeps an eye on free space, once a minute. The Hoard icon while there\'s room, the free percentage in amber near your limit and in red under it, and one warning when a drive drops under (10% by default). Click it and Hoard opens on that drive.',
    firstTitle: 'First run',
    first: 'Put Hoard.exe in a folder that stays put and double-click it. SmartScreen may complain because the exe isn\'t signed: More info, then Run anyway. Pick a drive. For the folders closed to normal users, Restart as administrator: Hoard comes back and reads the same drive again. Rather leave no trace? The portable zip keeps its settings in Hoard.ini next to the exe and never touches the registry.',
    coffeeTitle: ['Did it find the 40 GB', 'you\'d forgotten about?'],
    coffeeText: 'Hoard is free and stays free. If it gave you your disk back, a coffee on Ko-fi is how the next app gets written.',
    coffeeBtn: 'Buy me a coffee',
  },
  it: {
    description: 'Hoard ti mostra cosa riempie i dischi del tuo PC Windows: una mappa di ogni cartella, colorata per tipo di file, i file più grandi, cosa si può togliere. Non cancella niente. Gratis, senza installazione, senza internet.',
    kicker: 'App per Windows · v0.1.0',
    tagline: ['Cosa riempie il tuo disco,', 'su una mappa.'],
    download: 'Scarica (1,1 MB)',
    portable: 'Portable (zip)',
    source: 'Codice sorgente',
    meta: 'Windows 10 e 11 a 64 bit · niente da installare · gratis, licenza MIT',
    shotAlt: 'La finestra di Hoard: il disco C: come una mappa di riquadri colorati per tipo di file, con il riepilogo per tipo a destra',
    does: 'Cosa fa', doesnt: 'Cosa non fa',
    doesList: [
      'Legge un disco intero: un disco di sistema con un milione di file in meno di un minuto su un NVMe, pochi secondi la seconda volta.',
      'Te lo mostra come una mappa: ogni cartella e ogni file è un riquadro grande quanto lo spazio che occupa, colorato secondo cosa lo riempie.',
      'Clic su una cartella per entrarci, tasto destro su qualsiasi cosa per vederla in Esplora file.',
      'Elenca i 50 file più grandi del disco, e cosa c\'è in ogni cartella diviso per tipo di file.',
      'Ti indica quello che di solito si può togliere: file temporanei, Download, Cestino, Windows.old, cache dei pacchetti, node_modules.',
      'Tiene d\'occhio lo spazio libero dalla tray e ti avvisa una volta quando un disco scende sotto il tuo limite.',
    ],
    doesntList: [
      'Non cancella niente. Hoard mostra, Esplora file cancella, con il Cestino come rete di sicurezza.',
      'Non conta niente due volte: salta junction e collegamenti, i file di OneDrive solo online valgono zero.',
      'Non si tiene in memoria un milione di file: solo le cartelle, circa 50 MB per un disco di sistema pieno, liberati quando chiudi la finestra.',
      'Non si collega a internet. Niente telemetria, niente aggiornamenti automatici, niente account.',
      'Non pretende i permessi di amministratore. Te li propone, per le cartelle chiuse agli utenti normali.',
      'Non fa spazio da solo. Ti dice dove è finito; cosa buttare resta una decisione tua.',
    ],
    mapKicker: 'La mappa',
    mapTitle: ['Ogni riquadro grande quanto', 'lo spazio che occupa.'],
    mapLead: 'Un elenco di cartelle ti dà dei numeri. Una mappa ti fa vedere al primo sguardo che metà del disco è un gioco. Le cartelle grandi si aprono per mostrare cosa c\'è dentro, il colore dice che tipo di file riempie ogni riquadro, e passandoci sopra leggi nome, dimensione e quota.',
    mapAlt: 'Una cartella utente in Hoard: video, AppData, Download, immagini e progetti come riquadri, con le cartelle da guardare a destra',
    kinds: ['Video', 'Archivi e immagini disco', 'Immagini', 'Programmi e giochi', 'Audio', 'Codice e sviluppo', 'Documenti', 'Sistema, log e cache', 'Tutto il resto'],
    kindsNote: 'Otto colori da una palette controllata anche per chi non distingue bene i colori, il grigio per il resto. Il tipo lo dice l\'estensione.',
    howKicker: 'Come funziona',
    howTitle: ['Veloce, leggero,', 'e sincero su quello che non vede.'],
    howLead: 'Mentre legge vedi i contatori e le cartelle principali che crescono. Un milione di file sono un sacco di cartelle: Hoard ne legge sedici alla volta.',
    scanAlt: 'Hoard mentre legge il disco C: file, cartelle e gigabyte trovati fin lì, e le cartelle principali come barre che crescono',
    steps: [
      { t: 'Una chiamata per cartella', d: 'FindFirstFileEx consegna nome, dimensione e attributi di tutto quello che c\'è in una cartella in un colpo solo. Niente chiamate in più per ogni file, sedici cartelle alla volta.' },
      { t: 'Conta una volta sola', d: 'Junction e collegamenti simbolici li salta, così niente viene contato due volte e nessun collegamento lo fa girare in tondo. I file di OneDrive solo online valgono zero.' },
      { t: 'Tiene solo le cartelle', d: 'I file di una cartella li rilegge quando la apri: un disco di sistema pieno occupa circa 50 MB, e quello che vedi è aggiornato.' },
      { t: 'Ti dice cosa manca', d: 'Quello che ha trovato contro quello che il disco dice di usare: la differenza sono punti di ripristino e cartelle chiuse. Riavviato come amministratore ne legge quasi tutte.' },
    ],
    lookKicker: 'Da guardare',
    lookTitle: ['I soliti sospetti,', 'già trovati.'],
    lookLead: 'Cartelle che si riempiono da sole e che di solito si possono svuotare. Ognuna con una riga su cos\'è e su come si svuota, un pulsante per vederla sulla mappa e uno per aprirla in Esplora file.',
    hogs: ['File temporanei', 'Download', 'Cestino', 'Windows.old', 'Crash dump', 'Cache di npm, Yarn, pip, NuGet, Gradle', 'Tutte le node_modules', 'File di ibernazione'],
    trayTitle: 'Prima che il disco sia pieno',
    trayText: 'Nella tray Hoard tiene d\'occhio lo spazio libero, una volta al minuto. L\'icona di Hoard finché c\'è posto, la percentuale libera in arancione vicino al tuo limite e in rosso sotto, e un avviso quando un disco ci scende sotto (10% di base). Lo clicchi e Hoard si apre su quel disco.',
    firstTitle: 'Primo avvio',
    first: 'Metti Hoard.exe in una cartella che non sposti e fai doppio clic. SmartScreen potrebbe lamentarsi perché l\'exe non è firmato: Ulteriori informazioni, poi Esegui comunque. Scegli un disco. Per le cartelle chiuse agli utenti normali, Riavvia come amministratore: Hoard si riapre e rilegge lo stesso disco. Non vuoi lasciare tracce? Lo zip portable tiene le impostazioni in Hoard.ini accanto all\'exe e non tocca mai il registro.',
    coffeeTitle: ['Ti ha fatto ritrovare i 40 GB', 'di cui ti eri dimenticato?'],
    coffeeText: 'Hoard è gratis e resta gratis. Se ti ha restituito il disco, un caffè su Ko-fi è il modo in cui nasce la prossima app.',
    coffeeBtn: 'Offrimi un caffè',
  },
}[lang];
// the app's own colours for the kinds of file (ui/app.css in the Hoard repo), grey last
const kindColors = ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#0ca30c', '#9085e9', '#e66767', '#56625b'];
const kindIcons = [Film, Archive, Image, AppWindow, Music, CodeXml, FileText, Cog, File];
const stepIcons = [ScanSearch, Unlink, MemoryStick, Scale];
const hogIcons = [Timer, Download, Trash2, History, Bug, Package, Package, Power];
const frame = 'w-full rounded-3xl border border-line shadow-[0_40px_90px_-30px_rgb(0_0_0/0.9)]';
---
<Layout lang={lang} title="Hoard" description={c.description} path="/apps/hoard/" image="/og-hoard.png">
  <!-- HERO -->
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute right-[-10%] top-[10%] -z-10 h-[40rem] w-[40rem] rounded-full bg-[#be185d]/25 blur-[150px]"></div>
    <div class="wrap grid items-center gap-12 pb-16 pt-40 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="kicker blur-word">{c.kicker}</p>
        <h1 class="h-display mt-6"><span class="blur-word" style="--i:1">Hoard<span class="text-accent">.</span></span></h1>
        <p class="mt-6 max-w-xl text-[clamp(1.25rem,2.4vw,1.9rem)] leading-snug tracking-tight text-muted">
          <span class="blur-word" style="--i:3">{c.tagline[0]}</span> <span class="blur-word serif text-ink" style="--i:4">{c.tagline[1]}</span>
        </p>
        <div class="blur-word mt-10 flex flex-wrap gap-3" style="--i:5">
          <a href={EXE} class="btn btn-primary"><Download />{c.download}</a>
          <a href={ZIP} class="btn btn-ghost"><Usb />{c.portable}</a>
          <a href={REPO} target="_blank" rel="noopener" class="btn btn-ghost"><img src="/logos/github.svg" alt="" width="16" height="16" class="size-4" />{c.source}</a>
        </div>
        <p class="blur-word mt-5 text-sm text-faint" style="--i:6">{c.meta}</p>
      </div>
      <div class="blur-word relative mx-auto" style="--i:3">
        <div aria-hidden="true" class="absolute inset-8 rounded-[30%] bg-[#be185d] opacity-60 blur-3xl"></div>
        <img src="/assets/icons/apps/hoard.svg" alt="Hoard icon" width="320" height="320" class="relative w-[min(320px,70vw)] drop-shadow-2xl" />
      </div>
    </div>
  </section>

  <!-- THE WINDOW -->
  <section class="wrap pb-12">
    <img src={img('map')} alt={c.shotAlt} width="1600" height="1075" class={`reveal ${frame}`} />
  </section>

  <!-- DOES / DOESN'T -->
  <section class="wrap grid gap-4 py-12 lg:grid-cols-2">
    <div class="spot reveal p-8">
      <h2 class="text-2xl font-semibold tracking-tight">{c.does}</h2>
      <ul class="mt-6 space-y-4">{c.doesList.map((t) => <li class="flex gap-3 text-muted"><Check class="mt-0.5 size-5 shrink-0 text-accent" />{t}</li>)}</ul>
    </div>
    <div class="spot reveal p-8" style="--d:90ms">
      <h2 class="text-2xl font-semibold tracking-tight">{c.doesnt}</h2>
      <ul class="mt-6 space-y-4">{c.doesntList.map((t) => <li class="flex gap-3 text-muted"><X class="mt-0.5 size-5 shrink-0 text-faint" />{t}</li>)}</ul>
    </div>
  </section>

  <!-- THE MAP -->
  <section class="wrap py-24">
    <p class="kicker reveal">{c.mapKicker}</p>
    <h2 class="h-section reveal mt-4" style="--d:80ms">{c.mapTitle[0]} <span class="serif grad">{c.mapTitle[1]}</span></h2>
    <p class="lead reveal mt-6 max-w-2xl" style="--d:120ms">{c.mapLead}</p>
    <div class="mt-14 grid items-start gap-8 lg:grid-cols-[1.6fr_1fr]">
      <img src={img('folder')} alt={c.mapAlt} width="1600" height="1075" loading="lazy" class={`reveal ${frame}`} />
      <div class="spot reveal p-6" style="--d:90ms">
        <ul class="space-y-3">
          {c.kinds.map((k, i) => { const Icon = kindIcons[i]; return <li class="flex items-center gap-3 text-muted"><span class="size-3.5 shrink-0 rounded-[4px]" style={`background:${kindColors[i]}`}></span><Icon class="size-4 shrink-0 text-faint" />{k}</li>; })}
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-faint">{c.kindsNote}</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="wrap py-12">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="kicker reveal">{c.howKicker}</p>
        <h2 class="h-section reveal mt-4" style="--d:80ms">{c.howTitle[0]} <span class="serif grad">{c.howTitle[1]}</span></h2>
        <p class="lead reveal mt-6" style="--d:120ms">{c.howLead}</p>
      </div>
      <img src={img('scan')} alt={c.scanAlt} width="1600" height="1075" loading="lazy" class={`reveal ${frame}`} />
    </div>
    <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {c.steps.map((s, i) => {
        const Icon = stepIcons[i];
        return (
          <li class="spot reveal p-8" style={`--d:${i * 90}ms`}>
            <div class="flex items-center justify-between"><div class="icon-tile"><Icon /></div><span class="kicker text-faint">0{i + 1}</span></div>
            <h3 class="mt-6 text-xl font-semibold tracking-tight">{s.t}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.d}</p>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- WORTH A LOOK + TRAY -->
  <section class="wrap py-24">
    <p class="kicker reveal">{c.lookKicker}</p>
    <h2 class="h-section reveal mt-4" style="--d:80ms">{c.lookTitle[0]} <span class="serif grad">{c.lookTitle[1]}</span></h2>
    <p class="lead reveal mt-6 max-w-2xl" style="--d:120ms">{c.lookLead}</p>
    <div class="mt-14 grid items-start gap-4 lg:grid-cols-[1.4fr_1fr]">
      <ul class="grid gap-3 sm:grid-cols-2">
        {c.hogs.map((t, i) => { const Icon = hogIcons[i]; return <li class="spot reveal flex items-center gap-4 p-5 text-muted" style={`--d:${i * 50}ms`}><Icon class="size-5 shrink-0 text-accent" />{t}</li>; })}
      </ul>
      <div class="spot reveal p-8" style="--d:120ms">
        <div class="icon-tile"><Bell /></div>
        <h3 class="mt-6 text-xl font-semibold tracking-tight">{c.trayTitle}</h3>
        <p class="mt-3 leading-relaxed text-muted">{c.trayText}</p>
        <div class="mt-6 flex items-center gap-3" aria-hidden="true">
          <img src="/assets/icons/apps/hoard.svg" alt="" width="32" height="32" class="size-8" />
          <span class="grid size-8 place-items-center rounded-lg bg-[#d97706] text-sm font-bold text-white">14</span>
          <span class="grid size-8 place-items-center rounded-lg bg-[#dc2626] text-sm font-bold text-white">7</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FIRST RUN -->
  <section class="wrap py-12">
    <div class="spot reveal flex flex-col gap-5 p-8 md:flex-row md:items-start">
      <div class="icon-tile shrink-0"><ShieldExclamationPoint /></div>
      <div><h2 class="text-2xl font-semibold tracking-tight">{c.firstTitle}</h2><p class="mt-3 max-w-3xl leading-relaxed text-muted">{c.first}</p></div>
    </div>
  </section>

  <!-- COFFEE -->
  <section class="wrap py-24">
    <div class="spot reveal relative overflow-hidden px-6 py-20 text-center md:px-16">
      <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[380px] w-[680px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/20 blur-[120px]"></div>
      <div class="icon-tile mx-auto"><Coffee /></div>
      <h2 class="h-section mx-auto mt-6 max-w-2xl">{c.coffeeTitle[0]} <span class="serif grad">{c.coffeeTitle[1]}</span></h2>
      <p class="lead mx-auto mt-6 max-w-xl">{c.coffeeText}</p>
      <a href={SOCIAL.kofi} target="_blank" rel="noopener" class="btn btn-primary mt-8"><Coffee />{c.coffeeBtn}<ArrowUpRight /></a>
    </div>
  </section>
</Layout>
