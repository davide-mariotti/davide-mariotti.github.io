---
import { Download, Check, X, Usb, MicOff, Keyboard, Ear, ShieldExclamationPoint, Coffee, ArrowUpRight, MonitorSpeaker, Plug, Layers } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';
import { SOCIAL, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const EXE = 'https://github.com/davide-mariotti/Hush/raw/main/Hush.exe';
const ZIP = 'https://github.com/davide-mariotti/Hush/raw/main/Hush-portable.zip';
const REPO = 'https://github.com/davide-mariotti/Hush';
const img = (name: string) => `/assets/img/hush/${name}-${lang}.webp`;

const c = {
  en: {
    description: 'Hush switches your microphone off in every app with one key, Win+Shift+Q, and tells you who is listening and who is watching. Free, no install, no internet.',
    kicker: 'Windows app · v0.1.0',
    tagline: ['One key, every app,', 'microphone off.'],
    download: 'Download (1.1 MB)',
    portable: 'Portable (zip)',
    source: 'Source code',
    meta: 'Windows 10 and 11, 64-bit · nothing to install · free, MIT license',
    shotAlt: 'Hush\'s window: the microphone is on and Microsoft Teams is listening, with who hears you and who sees you right now',
    does: 'What it does', doesnt: "What it doesn't",
    doesList: [
      'Win+Shift+Q switches the microphone off in Teams, Meet, Zoom, Discord and the browser at once. Again, and it\'s back.',
      'One click on the tray icon does the same. Ochre: on. Green: an app is listening. Red: off.',
      'A small notice in the middle of the screen says "Microphone off", so you know without looking for the tray.',
      'Shows who hears you and who sees you right now, and which apps used microphone and webcam in the last 30 days.',
      'Switches off every microphone you have. One plugged in while they\'re off gets switched off too.',
      'Asks before closing with the microphone off: Windows would keep it silent for tomorrow\'s call.',
    ],
    doesntList: [
      'Switch the webcam off: Windows doesn\'t allow it without a driver. It tells you who is using it. A piece of tape does the rest.',
      'Listen. Hush never opens the microphone: it reads whether it\'s on, and who is using it.',
      'Watch your keyboard. The key is registered with Windows, Hush hears that one combination and nothing else.',
      'Mute single apps. It\'s the microphone that goes off, for everyone.',
      'Connect to the internet. No telemetry, no auto-updates, no account, no administrator rights.',
      'Run on macOS, Linux, or 32-bit Windows.',
    ],
    keyKicker: 'The key',
    keyTitle: ['Win+Shift+Q.', 'Anywhere.'],
    keyLead: 'In a full-screen call, in a game, in the middle of a spreadsheet: the key works wherever you are, and a notice tells you what happened. Q for quiet. Taken by another app? Pick another one: any modifiers with a letter, a digit or an F key, and F13-F24 or Pause even alone.',
    trayTitle: 'The tray says how things stand',
    tray: [['hush.svg', 'On, nobody is using it'], ['hush-live.svg', 'On, an app is listening right now'], ['hush-off.svg', 'Off, for every app']],
    settingsAlt: 'Hush\'s settings: start with Windows, the key with its modifiers, the on-screen notice',
    whoKicker: 'Who is listening',
    whoTitle: ['Off means off,', 'for everyone.'],
    whoLead: 'Hush switches the microphone off in Windows itself, not inside one app. Teams stays connected and gets nothing but silence, and the window tells you so. The webcam has its own card: Hush can\'t switch it off, but it tells you who is watching.',
    offAlt: 'Hush with the microphone off: Teams is still connected and gets nothing but silence',
    howKicker: 'How it works',
    howTitle: ['Four small things,', 'once a second.'],
    steps: [
      { t: 'The Windows switch', d: 'Core Audio, the same switch as Settings › System › Sound › Input, on every active microphone. Apps get silence until it\'s back on.' },
      { t: 'A key, not a hook', d: 'RegisterHotKey: Windows tells Hush about one combination and nothing else. No keyboard hook, nothing to install.' },
      { t: 'Windows\' own records', d: 'Who uses microphone and webcam comes from the records behind Windows\' privacy icon in the tray. An app that started and hasn\'t stopped is on now.' },
      { t: 'New microphones too', d: 'One plugged in while they\'re all off gets switched off. One switched back on from Windows\' settings is left alone, and the tray turns ochre.' },
    ],
    firstTitle: 'First run',
    first: 'Put Hush.exe in a folder that stays put and double-click it. SmartScreen may complain because the exe isn\'t signed: More info, then Run anyway. Then open the settings and turn on Start with Windows: the key only works while Hush is running. Rather leave no trace? The portable zip keeps its settings in Hush.ini next to the exe and never touches the registry.',
    coffeeTitle: ['Did it save you from a', '"can everyone hear me?"'],
    coffeeText: 'Hush is free and stays free. If it kept a private word private, a coffee on Ko-fi is how the next app gets written.',
    coffeeBtn: 'Buy me a coffee',
  },
  it: {
    description: 'Hush spegne il microfono in tutte le app con un tasto, Win+Shift+Q, e ti dice chi ti sta ascoltando e chi ti sta guardando. Gratis, senza installazione, senza internet.',
    kicker: 'App per Windows · v0.1.0',
    tagline: ['Un tasto, tutte le app,', 'microfono spento.'],
    download: 'Scarica (1,1 MB)',
    portable: 'Portable (zip)',
    source: 'Codice sorgente',
    meta: 'Windows 10 e 11 a 64 bit · niente da installare · gratis, licenza MIT',
    shotAlt: 'La finestra di Hush: il microfono è acceso e Microsoft Teams lo sta usando, con chi ti sente e chi ti vede in questo momento',
    does: 'Cosa fa', doesnt: 'Cosa non fa',
    doesList: [
      'Win+Shift+Q spegne il microfono in Teams, Meet, Zoom, Discord e nel browser, tutti insieme. Di nuovo, e torna acceso.',
      'Un clic sull\'icona nella tray fa lo stesso. Ocra: acceso. Verde: un\'app ti sta ascoltando. Rosso: spento.',
      'Un piccolo avviso in mezzo allo schermo scrive "Microfono spento", così lo sai senza cercare la tray.',
      'Ti fa vedere chi ti sente e chi ti vede adesso, e quali app hanno usato microfono e webcam negli ultimi 30 giorni.',
      'Spegne tutti i microfoni che hai. Uno collegato mentre sono spenti viene spento anche lui.',
      'Ti chiede prima di chiudersi con il microfono spento: Windows lo terrebbe muto per la chiamata di domani.',
    ],
    doesntList: [
      'Non spegne la webcam: Windows non lo permette senza un driver. Ti dice chi la sta usando. Al resto pensa un pezzo di nastro adesivo.',
      'Non ascolta. Hush non apre mai il microfono: legge se è acceso, e chi lo sta usando.',
      'Non spia la tastiera. Il tasto è registrato in Windows, a Hush arriva quella combinazione e nient\'altro.',
      'Non silenzia le singole app. È il microfono a spegnersi, per tutti.',
      'Non si collega a internet. Niente telemetria, niente aggiornamenti automatici, niente account, niente permessi di amministratore.',
      'Non gira su macOS, Linux, né su Windows a 32 bit.',
    ],
    keyKicker: 'Il tasto',
    keyTitle: ['Win+Shift+Q.', 'Ovunque.'],
    keyLead: 'In una chiamata a schermo intero, in un gioco, in mezzo a un foglio Excel: il tasto funziona ovunque tu sia, e un avviso ti dice cos\'è successo. Q come quiet. Lo usa già un\'altra app? Scegline un altro: qualsiasi modificatore con una lettera, un numero o un tasto F, e F13-F24 o Pausa anche da soli.',
    trayTitle: 'La tray ti dice com\'è la situazione',
    tray: [['hush.svg', 'Acceso, nessuno lo usa'], ['hush-live.svg', 'Acceso, un\'app ti sta ascoltando'], ['hush-off.svg', 'Spento, per tutte le app']],
    settingsAlt: 'Le impostazioni di Hush: avvio con Windows, il tasto con i suoi modificatori, l\'avviso a schermo',
    whoKicker: 'Chi ti ascolta',
    whoTitle: ['Spento vuol dire spento,', 'per tutti.'],
    whoLead: 'Hush spegne il microfono in Windows, non dentro una singola app. Teams resta collegato e riceve solo silenzio, e la finestra te lo dice. La webcam ha la sua scheda: Hush non la può spegnere, ma ti dice chi ti sta guardando.',
    offAlt: 'Hush con il microfono spento: Teams è ancora collegato e riceve solo silenzio',
    howKicker: 'Come funziona',
    howTitle: ['Quattro piccole cose,', 'una volta al secondo.'],
    steps: [
      { t: 'L\'interruttore di Windows', d: 'Core Audio, lo stesso interruttore di Impostazioni › Sistema › Audio › Input, su ogni microfono attivo. Le app ricevono silenzio finché non lo riaccendi.' },
      { t: 'Un tasto, non un hook', d: 'RegisterHotKey: Windows avvisa Hush di una combinazione e di nient\'altro. Niente hook della tastiera, niente da installare.' },
      { t: 'I registri di Windows', d: 'Chi usa microfono e webcam viene dai registri dietro l\'icona della privacy di Windows nella tray. Un\'app che ha iniziato e non ha finito lo sta usando adesso.' },
      { t: 'Anche i microfoni nuovi', d: 'Uno collegato mentre sono tutti spenti viene spento. Uno riacceso dalle impostazioni di Windows resta acceso, e la tray torna ocra.' },
    ],
    firstTitle: 'Primo avvio',
    first: 'Metti Hush.exe in una cartella che non sposti e fai doppio clic. SmartScreen potrebbe lamentarsi perché l\'exe non è firmato: Ulteriori informazioni, poi Esegui comunque. Poi apri le impostazioni e attiva Avvia con Windows: il tasto funziona solo mentre Hush è acceso. Non vuoi lasciare tracce? Lo zip portable tiene le impostazioni in Hush.ini accanto all\'exe e non tocca mai il registro.',
    coffeeTitle: ['Ti ha salvato da un', '"ma mi sentite tutti?"'],
    coffeeText: 'Hush è gratis e resta gratis. Se ha tenuto privata una frase che doveva restarlo, un caffè su Ko-fi è il modo in cui nasce la prossima app.',
    coffeeBtn: 'Offrimi un caffè',
  },
}[lang];
const stepIcons = [MicOff, Keyboard, Ear, Plug];
const frame = 'w-full rounded-3xl border border-line shadow-[0_40px_90px_-30px_rgb(0_0_0/0.9)]';
const keys = ['Shift', 'Win', 'Q'];
---
<Layout lang={lang} title="Hush" description={c.description} path="/apps/hush/" image="/og-hush.png">
  <!-- HERO -->
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute right-[-10%] top-[10%] -z-10 h-[40rem] w-[40rem] rounded-full bg-[#a16207]/25 blur-[150px]"></div>
    <div class="wrap grid items-center gap-12 pb-16 pt-40 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="kicker blur-word">{c.kicker}</p>
        <h1 class="h-display mt-6"><span class="blur-word" style="--i:1">Hush<span class="text-accent">.</span></span></h1>
        <p class="mt-6 max-w-xl text-[clamp(1.25rem,2.4vw,1.9rem)] leading-snug tracking-tight text-muted">
          <span class="blur-word" style="--i:3">{c.tagline[0]}</span> <span class="blur-word serif text-ink" style="--i:4">{c.tagline[1]}</span>
        </p>
        <div class="blur-word mt-10 flex flex-wrap gap-3" style="--i:5">
          <a href={EXE} class="btn btn-primary"><Download />{c.download}</a>
          <a href={ZIP} class="btn btn-ghost"><Usb />{c.portable}</a>
          <a href={REPO} target="_blank" rel="noopener" class="btn btn-ghost"><img src="/logos/github.svg" alt="" width="16" height="16" class="size-4" />{c.source}</a>
        </div>
        <p class="blur-word mt-5 text-sm text-faint" style="--i:6">{c.meta}</p>
      </div>
      <div class="blur-word relative mx-auto" style="--i:3">
        <div aria-hidden="true" class="absolute inset-8 rounded-[30%] bg-[#a16207] opacity-60 blur-3xl"></div>
        <img src="/assets/icons/apps/hush.svg" alt="Hush icon" width="320" height="320" class="relative w-[min(320px,70vw)] drop-shadow-2xl" />
      </div>
    </div>
  </section>

  <!-- THE WINDOW -->
  <section class="wrap pb-12">
    <img src={img('live')} alt={c.shotAlt} width="1600" height="1164" class={`reveal ${frame}`} />
  </section>

  <!-- DOES / DOESN'T -->
  <section class="wrap grid gap-4 py-12 lg:grid-cols-2">
    <div class="spot reveal p-8">
      <h2 class="text-2xl font-semibold tracking-tight">{c.does}</h2>
      <ul class="mt-6 space-y-4">{c.doesList.map((t) => <li class="flex gap-3 text-muted"><Check class="mt-0.5 size-5 shrink-0 text-accent" />{t}</li>)}</ul>
    </div>
    <div class="spot reveal p-8" style="--d:90ms">
      <h2 class="text-2xl font-semibold tracking-tight">{c.doesnt}</h2>
      <ul class="mt-6 space-y-4">{c.doesntList.map((t) => <li class="flex gap-3 text-muted"><X class="mt-0.5 size-5 shrink-0 text-faint" />{t}</li>)}</ul>
    </div>
  </section>

  <!-- THE KEY -->
  <section class="wrap py-24">
    <p class="kicker reveal">{c.keyKicker}</p>
    <h2 class="h-section reveal mt-4" style="--d:80ms">{c.keyTitle[0]} <span class="serif grad">{c.keyTitle[1]}</span></h2>
    <p class="lead reveal mt-6 max-w-2xl" style="--d:120ms">{c.keyLead}</p>
    <div class="mt-14 grid items-start gap-8 lg:grid-cols-[1fr_1.5fr]">
      <div class="grid gap-4">
        <div class="spot reveal flex flex-wrap items-center gap-3 p-8">
          {keys.map((k, i) => <>{i > 0 && <span class="text-faint">+</span>}<kbd class="grid min-w-14 place-items-center rounded-xl border border-b-4 border-line bg-surface-2 px-4 py-3 font-mono text-lg text-ink">{k}</kbd></>)}

        </div>
        <div class="spot reveal p-8" style="--d:90ms">
          <h3 class="text-xl font-semibold tracking-tight">{c.trayTitle}</h3>
          <ul class="mt-6 space-y-4">
            {c.tray.map(([file, t]) => <li class="flex items-center gap-4 text-muted"><img src={`/assets/icons/apps/${file}`} alt="" width="36" height="36" class="size-9 shrink-0" />{t}</li>)}
          </ul>
        </div>
      </div>
      <img src={img('settings')} alt={c.settingsAlt} width="1600" height="1164" loading="lazy" class={`reveal ${frame}`} />
    </div>
  </section>

  <!-- WHO IS LISTENING -->
  <section class="wrap py-12">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <p class="kicker reveal">{c.whoKicker}</p>
        <h2 class="h-section reveal mt-4" style="--d:80ms">{c.whoTitle[0]} <span class="serif grad">{c.whoTitle[1]}</span></h2>
        <p class="lead reveal mt-6" style="--d:120ms">{c.whoLead}</p>
        <div class="reveal mt-8 flex flex-wrap gap-2" style="--d:160ms"><span class="chip"><MonitorSpeaker class="size-3.5 text-accent" />Core Audio</span><span class="chip"><Keyboard class="size-3.5 text-accent" />RegisterHotKey</span><span class="chip"><Layers class="size-3.5 text-accent" />WebView2</span></div>
      </div>
      <img src={img('off')} alt={c.offAlt} width="1600" height="1164" loading="lazy" class={`reveal ${frame}`} />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="wrap py-24">
    <p class="kicker reveal">{c.howKicker}</p>
    <h2 class="h-section reveal mt-4" style="--d:80ms">{c.howTitle[0]} <span class="serif grad">{c.howTitle[1]}</span></h2>
    <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {c.steps.map((s, i) => {
        const Icon = stepIcons[i];
        return (
          <li class="spot reveal p-8" style={`--d:${i * 90}ms`}>
            <div class="flex items-center justify-between"><div class="icon-tile"><Icon /></div><span class="kicker text-faint">0{i + 1}</span></div>
            <h3 class="mt-6 text-xl font-semibold tracking-tight">{s.t}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.d}</p>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- FIRST RUN -->
  <section class="wrap py-12">
    <div class="spot reveal flex flex-col gap-5 p-8 md:flex-row md:items-start">
      <div class="icon-tile shrink-0"><ShieldExclamationPoint /></div>
      <div><h2 class="text-2xl font-semibold tracking-tight">{c.firstTitle}</h2><p class="mt-3 max-w-3xl leading-relaxed text-muted">{c.first}</p></div>
    </div>
  </section>

  <!-- COFFEE -->
  <section class="wrap py-24">
    <div class="spot reveal relative overflow-hidden px-6 py-20 text-center md:px-16">
      <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[380px] w-[680px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/20 blur-[120px]"></div>
      <div class="icon-tile mx-auto"><Coffee /></div>
      <h2 class="h-section mx-auto mt-6 max-w-2xl">{c.coffeeTitle[0]} <span class="serif grad">{c.coffeeTitle[1]}</span></h2>
      <p class="lead mx-auto mt-6 max-w-xl">{c.coffeeText}</p>
      <a href={SOCIAL.kofi} target="_blank" rel="noopener" class="btn btn-primary mt-8"><Coffee />{c.coffeeBtn}<ArrowUpRight /></a>
    </div>
  </section>
</Layout>
