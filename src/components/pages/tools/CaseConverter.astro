---
import { Eraser } from '@lucide/astro';
import ToolPage from '../../ToolPage.astro';
import CopyButton from '../../CopyButton.astro';
import type { Lang } from '../../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = {
  en: {
    title: ['Case', 'converter.'],
    description: 'Convert text to Sentence case, lower case, UPPER CASE, Title Case, camelCase, snake_case, URL slugs and iNVERSE in your browser.',
    kicker: 'Runs on your device',
    lead: 'Paste the text, pick a style, copy the result. For headlines typed with Caps Lock on, and variable names typed with it off.',
    input: 'Your text', output: 'Result', style: 'Style', placeholder: 'Paste or type here…', clear: 'Clear', copy: 'Copy result',
    stats: [['character', 'characters'], ['word', 'words'], ['line', 'lines']],
    modes: { sentence: 'Sentence case', lower: 'lower case', upper: 'UPPER CASE', title: 'Title Case', camel: 'camelCase', snake: 'snake_case', slug: 'url-slug', inverse: 'iNVERSE cASE' },
    does: [
      'Converts to sentence case, lower, upper, title case, camelCase, snake_case, URL slugs and inverted case.',
      'Handles accents properly: "è" becomes "È", and slugs turn "perché" into "perche".',
      'Updates the result as you type, and counts characters, words and lines.',
    ],
    doesnt: [
      'Send your text anywhere.',
      'Know grammar: Title Case capitalises every word, "of" and "the" included, and sentence case lowercases names.',
      'Fix typos. That one\'s still on you.',
    ],
  },
  it: {
    title: ['Maiuscole e', 'minuscole.'],
    description: 'Converti il testo in frase normale, minuscolo, MAIUSCOLO, Iniziali Maiuscole, camelCase, snake_case, slug per URL e iNVERTITO, nel browser.',
    kicker: 'Gira sul tuo dispositivo',
    lead: 'Incolla il testo, scegli lo stile, copia il risultato. Per i titoli scritti col Bloc Maiusc acceso, e per i nomi di variabile scritti con quello spento.',
    input: 'Il tuo testo', output: 'Risultato', style: 'Stile', placeholder: 'Incolla o scrivi qui…', clear: 'Svuota', copy: 'Copia il risultato',
    stats: [['carattere', 'caratteri'], ['parola', 'parole'], ['riga', 'righe']],
    modes: { sentence: 'Come una frase', lower: 'minuscolo', upper: 'MAIUSCOLO', title: 'Iniziali Maiuscole', camel: 'camelCase', snake: 'snake_case', slug: 'slug-per-url', inverse: 'iNVERTITO' },
    does: [
      'Converte in frase normale, minuscolo, maiuscolo, iniziali maiuscole, camelCase, snake_case, slug per URL e maiuscole invertite.',
      'Tratta bene gli accenti: "è" diventa "È", e negli slug "perché" diventa "perche".',
      'Aggiorna il risultato mentre scrivi e conta caratteri, parole e righe.',
    ],
    doesnt: [
      'Non invia il tuo testo da nessuna parte.',
      'Non conosce la grammatica: Iniziali Maiuscole mette la maiuscola a ogni parola, articoli compresi, e la frase normale abbassa anche i nomi propri.',
      'Non corregge i refusi. Quelli restano a te.',
    ],
  },
}[lang];
---
<ToolPage lang={lang} slug="case-converter" title={c.title as [string, string]} description={c.description} lead={c.lead} kicker={c.kicker} does={c.does} doesnt={c.doesnt}>
  <div id="cv" class="spot grid gap-6 p-6 sm:p-8" data-stats={JSON.stringify(c.stats)}>
    <div>
      <label class="label" for="cv-in">{c.input}</label>
      <textarea id="cv-in" class="field !font-sans !text-base" rows="6" placeholder={c.placeholder}></textarea>
      <p id="cv-stats" class="kicker mt-2"></p>
    </div>
    <div role="group" aria-label={c.style} class="flex flex-wrap gap-2">
      {Object.entries(c.modes).map(([k, label], i) => (
        <button type="button" class="btn btn-ghost !px-4 !py-2 !text-sm" data-mode={k} aria-pressed={String(i === 0)}>{label}</button>
      ))}
    </div>
    <div>
      <label class="label" for="cv-out">{c.output}</label>
      <textarea id="cv-out" class="field !font-sans !text-base" rows="6" readonly></textarea>
      <div class="mt-3 flex flex-wrap gap-2">
        <CopyButton target="#cv-out" label={c.copy} />
        <button type="button" id="cv-clear" class="btn btn-ghost !py-2.5"><Eraser />{c.clear}</button>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import { CASES, type CaseName } from '../../../scripts/tools/case';

  const root = document.getElementById('cv')!;
  const input = document.getElementById('cv-in') as HTMLTextAreaElement;
  const output = document.getElementById('cv-out') as HTMLTextAreaElement;
  const units: string[][] = JSON.parse(root.dataset.stats!); // [singular, plural] for characters, words, lines
  let mode: CaseName = 'sentence';

  function run() {
    const s = input.value;
    output.value = CASES[mode](s);
    const counts = [[...s].length, s.split(/\s+/).filter(Boolean).length, s ? s.split('\n').length : 0];
    document.getElementById('cv-stats')!.textContent = counts.map((n, i) => `${n} ${units[i][n === 1 ? 0 : 1]}`).join(' · ');
  }
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-mode]');
    if (!b) return;
    mode = b.dataset.mode as CaseName;
    root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    run();
  });
  input.addEventListener('input', run);
  document.getElementById('cv-clear')!.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
  run();
</script>
