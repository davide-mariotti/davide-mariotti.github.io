---
// Endless strip of the tech I use (logos from svgl.app). The list is rendered twice for a seamless loop.
const logos = [
  ['html5', 'HTML5'], ['css', 'CSS'], ['javascript', 'JavaScript'], ['typescript', 'TypeScript'], ['react', 'React'],
  ['astro', 'Astro'], ['nodejs', 'Node.js'], ['python', 'Python'], ['csharp', 'C#'], ['godot', 'Godot'],
  ['firebase', 'Firebase'], ['tailwind', 'Tailwind CSS'], ['bootstrap', 'Bootstrap'], ['vite', 'Vite'], ['git', 'Git'],
  ['vscode', 'VS Code'], ['figma', 'Figma'], ['photoshop', 'Photoshop'], ['illustrator', 'Illustrator'],
  ['aftereffects', 'After Effects'], ['premiere', 'Premiere Pro'],
];
---
<div class="marquee group relative overflow-hidden">
  <ul class="flex w-max animate-marquee gap-14 pr-14 group-hover:[animation-play-state:paused]">
    {[...logos, ...logos].map(([file, name], i) => (
      <li class="flex items-center gap-3 whitespace-nowrap" aria-hidden={i >= logos.length ? 'true' : undefined}>
        <img src={`/logos/${file}.svg`} alt="" width="28" height="28" loading="lazy" class="size-7 object-contain opacity-55 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0" />
        <span class="text-sm text-faint">{name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .marquee { mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
</style>
