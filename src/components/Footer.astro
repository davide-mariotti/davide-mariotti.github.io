---
import { Coffee, ArrowUpRight } from '@lucide/astro';
import Logo from './Logo.astro';
import { ui, localize, SOCIAL, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const explore = [
  [localize(lang, '/apps/'), t.nav.apps],
  [localize(lang, '/tools/'), t.nav.tools],
  ['/games/', t.nav.games],
  [localize(lang, '/about/'), t.nav.about],
  [localize(lang, '/contact/'), t.nav.contact],
];
const elsewhere = [
  [SOCIAL.github, 'GitHub', 'github'],
  [SOCIAL.linkedin, 'LinkedIn', 'linkedin'],
  [SOCIAL.instagram, 'Instagram', 'instagram'],
];
---
<footer class="relative mt-32 border-t border-line">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo class="h-8 w-auto text-ink" />
      <p class="mt-5 text-sm leading-relaxed text-muted">{t.footer.tagline}</p>
      <a href={SOCIAL.kofi} target="_blank" rel="noopener" class="btn btn-ghost mt-6 !text-sm">
        <Coffee class="text-accent" />{t.footer.coffee}
      </a>
    </div>
    <div>
      <p class="kicker mb-4">{t.footer.explore}</p>
      <ul class="space-y-2 text-sm">
        {explore.map(([href, label]) => <li><a href={href} class="text-muted transition-colors hover:text-ink">{label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="kicker mb-4">{t.footer.elsewhere}</p>
      <ul class="space-y-2 text-sm">
        {elsewhere.map(([href, label, logo]) => (
          <li>
            <a href={href} target="_blank" rel="noopener me" class="group inline-flex items-center gap-2.5 text-muted transition-colors hover:text-ink">
              <img src={`/logos/${logo}.svg`} alt="" width="16" height="16" class="size-4 opacity-60 grayscale transition group-hover:opacity-100 group-hover:grayscale-0" />
              {label}<ArrowUpRight class="size-3.5 opacity-0 transition group-hover:opacity-100" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-line py-6 text-xs text-faint sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} Davide Mariotti</p>
    <p>{t.footer.built}</p>
  </div>
</footer>
