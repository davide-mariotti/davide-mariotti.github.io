---
// dm. mark: the strokes are white, the dot is the one accent green of the site.
interface Props { class?: string; draw?: boolean }
const { class: cls = '', draw = false } = Astro.props;
---
<svg class={cls} viewBox="7.5 12.5 108.8 68" role="img" aria-label="dm. Davide Mariotti" data-draw={draw ? '' : undefined}>
  <path
    d="M45,20V73M45,58A15,15 0 1 1 45,57.99M45,54A11,11 0 0 1 67,54V73M67,54A11,11 0 0 1 89,54V73"
    fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" pathLength="1"
  />
  <circle cx="107.7" cy="71.9" r="6.6" fill="var(--color-accent)" />
</svg>
