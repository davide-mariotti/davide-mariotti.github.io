---
import Logo from './Logo.astro';
---
<!-- Shown only when the head script set html[data-intro]: first page of the session, motion allowed. Click skips it. -->
<div class="intro" aria-hidden="true">
  <div class="intro-glow"></div>
  <Logo class="intro-mark" />
  <p class="intro-line">davide mariotti · front-end developer</p>
</div>
<script is:inline>
  document.querySelector('.intro')?.addEventListener('click', () => document.documentElement.removeAttribute('data-intro'));
</script>

<style is:global>
  .intro { display: none; }
  html[data-intro] .intro {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.5rem;
    background: var(--color-bg);
    color: var(--color-ink);
    animation: intro-out 0.8s var(--ease-out-expo) 1.25s forwards;
  }
  .intro-mark { width: min(220px, 42vw); overflow: visible; }
  .intro-mark path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: intro-draw 0.95s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards; }
  .intro-mark circle { transform-box: fill-box; transform-origin: center; transform: translateY(-160%) scale(0); animation: intro-dot 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s forwards; }
  .intro-glow {
    position: absolute;
    width: 46vmax;
    height: 46vmax;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(47 227 127 / 0.22), transparent 60%);
    opacity: 0;
    animation: intro-glow 1.2s ease-out 0.75s forwards;
  }
  .intro-line {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0;
    animation: intro-fade 0.6s ease-out 0.55s forwards;
  }
  @keyframes intro-draw { to { stroke-dashoffset: 0; } }
  @keyframes intro-dot { to { transform: none; } }
  @keyframes intro-glow { 50% { opacity: 1; } to { opacity: 0.6; } }
  @keyframes intro-fade { to { opacity: 1; } }
  @keyframes intro-out {
    to { clip-path: inset(0 0 100% 0); visibility: hidden; }
  }
  html[data-intro] .intro { clip-path: inset(0 0 0 0); }
</style>
